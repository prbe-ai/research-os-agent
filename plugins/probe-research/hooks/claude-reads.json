{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -c 'S=\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\"; S=\"${S%/}/hooks/stop-wake.sh\"; [ -f \"$S\" ] || exit 0; exec /bin/bash \"$S\" alert'",
            "timeout": 604860,
            "asyncRewake": true,
            "rewakeMessage": "Message from the Probe daemon (not an error; the session is not blocked):",
            "rewakeSummary": "Probe run alert"
          },
          {
            "type": "command",
            "command": "/bin/bash -c 'S=\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\"; S=\"${S%/}/hooks/stop-wake.sh\"; [ -f \"$S\" ] || exit 0; exec /bin/bash \"$S\" answer'",
            "timeout": 604860,
            "asyncRewake": true,
            "rewakeMessage": "Message from the Probe daemon (not an error; the session is not blocked):",
            "rewakeSummary": "Probe answer"
          },
          {
            "type": "command",
            "command": "/bin/bash -c 'S=\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\"; S=\"${S%/}/hooks/stop-wake.sh\"; [ -f \"$S\" ] || exit 0; exec /bin/bash \"$S\" message'",
            "timeout": 604860,
            "asyncRewake": true,
            "rewakeMessage": "Message from the Probe daemon (not an error; the session is not blocked):",
            "rewakeSummary": "Probe message"
          }
        ]
      }
    ]
  }
}
