{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -c 'ROOT=\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\"; [ -n \"${PLUGIN_ROOT:-}\" ] && export PROBE_AGENT=codex; exec \"$ROOT/hooks/session-start.sh\"'"
          },
          {
            "type": "command",
            "command": "/bin/bash -c 'ROOT=\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\"; PY=\"$(command -v python3)\" || exit 0; exec \"$PY\" \"$ROOT/hooks/statusline_refresh.py\"'",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -c 'ROOT=\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\"; [ -n \"${PLUGIN_ROOT:-}\" ] && export PROBE_AGENT=codex; export PROBE_HOOK_EVENT=precompact; exec \"$ROOT/hooks/session-start.sh\"'",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|Skill|SlashCommand)$|probe[-_]research",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -c 'ROOT=\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\"; [ -n \"${PLUGIN_ROOT:-}\" ] && export PROBE_AGENT=codex; PY=\"$(command -v python3)\" || exit 0; exec \"$PY\" \"$ROOT/hooks/telemetry.py\" post-tool'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/bin/bash -c 'ROOT=\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\"; PY=\"$(command -v python3)\" || exit 0; exec \"$PY\" \"$ROOT/hooks/tracking_guard.py\"'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/bin/bash -c 'ROOT=\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\"; PY=\"$(command -v python3)\" || exit 0; exec \"$PY\" \"$ROOT/hooks/statusline_refresh.py\"'",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -c 'ROOT=\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\"; [ -n \"${PLUGIN_ROOT:-}\" ] && export PROBE_AGENT=codex; PY=\"$(command -v python3)\" || exit 0; exec \"$PY\" \"$ROOT/hooks/telemetry.py\" session-end'",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -c 'ROOT=\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\"; FLAG=\"${XDG_STATE_HOME:-$HOME/.local/state}/probe/statusline-notify\"; [ -f \"$FLAG\" ] || exit 0; PY=\"$(command -v python3)\" || exit 0; exec \"$PY\" \"$ROOT/hooks/statusline_notify.py\"'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
