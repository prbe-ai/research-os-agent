#!/bin/sh
# Emit the Probe Research MCP Authorization header as JSON on stdout.
#
# Claude Code runs this on every connect and again after a 401/403, so a rotated
# token is picked up without restarting the session. It runs through a plain shell
# with whatever environment Claude Code itself has: launched from the dock, no
# profile is ever sourced and ~/.local/bin is not on PATH.
#
# Resolution matches sdk.config.resolve: PROBE_MCP_TOKEN first, so a shell that
# already exports it keeps working untouched, then the `mcp_token` that
# `probe mcp token set` writes. The write token in the same file is never read —
# this surface is read-only.
#
# Caveat of that order: if the launching shell exports a *stale* PROBE_MCP_TOKEN, this
# re-emits it after every 401 and the token can never heal — `probe mcp token set` writes
# a config the export keeps shadowing. `probe mcp status` names that case; the fix is to
# drop the export and let the config win.
#
# It reads the config file rather than calling `probe mcp headers` on purpose. The
# plugin and the CLI version independently, and a CLI older than the plugin fails
# with `No such command 'mcp'` and takes the MCP down with it. Reading one JSON key
# cannot skew, and skips a ~300ms interpreter start on every connect. The CLI is
# the last resort, for a box with no python.
#
# Reading it means reading BOTH shapes. The file has been v2 — named contexts, the
# credential nested under `contexts.<current_context>` — since the workspace surface
# landed, and this read only ever knew v1's top-level key. So the fast path returned
# nothing on every install the wizard has ever produced, and the whole surface silently
# rode on the CLI fallback: fine on a machine with `probe` at one of the four paths
# below, and a hard failure on any other. A failure here is not a degraded MCP, it is
# an unauthenticated request, which the edge answers with a `WWW-Authenticate`
# challenge — so Claude Code discovers an authorization server and offers OAuth, and
# the user is sent to `/mcp` to re-authenticate a device the installer had already
# authorized. Mirror sdk.config._migrate/load_context here: contexts first, v1 flat
# second.
#
# Diagnostics go to stderr; stdout must be JSON and nothing else.
set -eu

PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)}"
PLUGIN_JSON="$PLUGIN_ROOT/.claude-plugin/plugin.json"
# The metadata is first-party and tiny, so a small sed pipeline is substantially
# cheaper than starting the CLI. The extraction is followed by strict SemVer
# validation; a missing or malformed file drops telemetry while leaving
# Authorization untouched.
PLUGIN_VERSION=""
if [ -r "$PLUGIN_JSON" ]; then
  PLUGIN_VERSION=$(sed -n \
    's/.*"version"[[:space:]]*:[[:space:]]*"\([0-9][0-9A-Za-z]*\([._+-][0-9A-Za-z][0-9A-Za-z]*\)*\)".*/\1/p' \
    "$PLUGIN_JSON" | sed -n '1p') || PLUGIN_VERSION=""
  [ "${#PLUGIN_VERSION}" -le 64 ] || PLUGIN_VERSION=""
  if [ -n "$PLUGIN_VERSION" ] && ! printf '%s\n' "$PLUGIN_VERSION" | grep -Eq \
    '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?(\+[0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*)?$'
  then
    PLUGIN_VERSION=""
  fi
  version_without_build=${PLUGIN_VERSION%%+*}
  case "$version_without_build" in
    *-*)
      prerelease=${version_without_build#*-}
      if printf '%s\n' "$prerelease" | grep -Eq '(^|\.)0[0-9]+(\.|$)'; then
        PLUGIN_VERSION=""
      fi
      ;;
  esac
fi

# Which coding agent is on the other end, and which of its conversations. The hosted
# MCP cannot learn either any other way: it is stateless and multi-tenant, and all it
# otherwise receives is a bearer token. With them it can join a tool call back to the
# captured transcript, whose graph id is agent_session:{agent}:{session_id} -- so the
# PAIR is the key and a lone session id resolves to nothing.
#
# MIRRORS src/probe/sdk/agent_session.py (AGENTS order, _SESSION_RE, the codex pairing
# check). Only agents whose transcripts actually reach Research OS are named: Cursor is
# detectable but uncaptured, so it gets no headers rather than a link nobody can follow.
#
# THE CHARSET CHECK IS NOT COSMETIC. This value is interpolated into the JSON on
# stdout, and a failure here is not degraded telemetry -- it is an unauthenticated
# request, a WWW-Authenticate challenge, and a user bounced into OAuth to re-authorize
# a device the installer already authorized. The case glob rejects anything outside
# [A-Za-z0-9._:-], which includes the quote, backslash and newline that could break the
# document. A glob is used rather than grep -E because grep matches per LINE, so an
# embedded newline could satisfy an anchored pattern; a glob sees the whole string.
AGENT_LABEL=""
AGENT_SESSION=""
if [ -n "${CLAUDECODE:-}" ] || [ -n "${CLAUDE_CODE_ENTRYPOINT:-}" ]; then
  AGENT_LABEL="claude_code"
  AGENT_SESSION="${CLAUDE_CODE_SESSION_ID:-}"
elif [ -n "${CURSOR_TRACE_ID:-}" ]; then
  AGENT_LABEL=""            # detectable, deliberately uncaptured
elif [ -n "${CODEX_SANDBOX:-}" ] || [ -n "${CODEX_THREAD_ID:-}" ]; then
  # Codex is reported only when its tap holds a credential: that is the durable
  # evidence this device completed pairing. Merely running under Codex must not create
  # a transcript link that can never resolve. Presence only -- the secret is never read.
  CODEX_TAP_DIR="${PRBE_CODEX_TAP_PLUGIN_DIR:-}"
  if [ -z "$CODEX_TAP_DIR" ]; then
    if [ -e "$HOME/.codex/state/prbe-codex-tap-plugin" ] &&
       [ ! -e "$HOME/.codex/state/probe-research-tap" ]; then
      CODEX_TAP_DIR="$HOME/.codex/state/prbe-codex-tap-plugin"
    else
      CODEX_TAP_DIR="$HOME/.codex/state/probe-research-tap"
    fi
  fi
  if [ -n "${PRBE_CODEX_TAP_TOKEN:-}" ] || [ -s "$CODEX_TAP_DIR/.token" ]; then
    AGENT_LABEL="codex"
    AGENT_SESSION="${CODEX_THREAD_ID:-}"
  fi
fi

case "$AGENT_SESSION" in
  *[!A-Za-z0-9._:-]*) AGENT_SESSION="" ;;
esac
if [ "${#AGENT_SESSION}" -lt 8 ] || [ "${#AGENT_SESSION}" -gt 200 ]; then
  AGENT_SESSION=""
fi

# A leading-comma fragment so both emit branches stay single printf calls. Empty when
# there is nothing to say -- never a blank header.
AGENT_HEADERS=""
if [ -n "$AGENT_LABEL" ] && [ -n "$AGENT_SESSION" ]; then
  AGENT_HEADERS=$(printf ', "X-Probe-Agent": "%s", "X-Probe-Agent-Session": "%s"' \
    "$AGENT_LABEL" "$AGENT_SESSION")
fi

emit() {
  if [ -n "$PLUGIN_VERSION" ]; then
    printf '{"Authorization": "Bearer %s", "X-Probe-Client": "plugin", "X-Probe-Client-Version": "%s"%s}\n' \
      "$1" "$PLUGIN_VERSION" "$AGENT_HEADERS"
  else
    printf '{"Authorization": "Bearer %s"%s}\n' "$1" "$AGENT_HEADERS"
  fi
  exit 0
}

[ -n "${PROBE_MCP_TOKEN:-}" ] && emit "$PROBE_MCP_TOKEN"

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/probe/config.json"
if [ -r "$CONFIG" ]; then
  for python in python3 python; do
    command -v "$python" >/dev/null 2>&1 || continue
    token=$("$python" -c '
import json, sys
try:
    data = json.load(open(sys.argv[1]))
except (OSError, ValueError):
    data = {}
if not isinstance(data, dict):
    data = {}
contexts = data.get("contexts")
if isinstance(contexts, dict):
    # v2. An absent/unknown current_context falls back to "default", exactly as
    # config.current_context_name does — never to another context, which would hand
    # the MCP a credential for an endpoint the user is not pointed at.
    context = contexts.get(data.get("current_context") or "default")
    data = context if isinstance(context, dict) else {}
print(data.get("mcp_token") or "")
' "$CONFIG" 2>/dev/null) || token=""
    [ -n "$token" ] && emit "$token"
    break
  done
fi

# No python, or nothing stored: let the CLI answer if it is new enough to know how.
# Try every candidate — an old `probe` first on PATH must not hide a newer one, which is
# the whole reason this is a list. uv names its tool dir after the DISTRIBUTION, so
# both spellings appear: `probe-research` (current) and `probe-agent` (pre-2026-07-15
# installs, still on disk until the user reinstalls).
for candidate in \
  "$(command -v probe 2>/dev/null || true)" \
  "$HOME/.local/bin/probe" \
  "$HOME/.local/share/uv/tools/probe-research/bin/probe" \
  "$HOME/.local/share/uv/tools/probe-agent/bin/probe"
do
  [ -n "$candidate" ] && [ -x "$candidate" ] || continue
  if out=$("$candidate" mcp headers 2>/dev/null) && [ -n "$out" ]; then
    token=$(printf '%s\n' "$out" | sed -n \
      's/.*"Authorization"[[:space:]]*:[[:space:]]*"Bearer \([^"]*\)".*/\1/p')
    [ -n "$token" ] && emit "$token"
  fi
done

echo "no Probe MCP token: run \`probe mcp token set\` (or export PROBE_MCP_TOKEN)" >&2
exit 1
