{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -c 'ROOT=\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\"; [ -n \"${PLUGIN_ROOT:-}\" ] && export PROBE_TAP_SOURCE=codex; exec \"$ROOT/hooks/session-start.sh\"'",
            "timeout": 10,
            "statusMessage": "Starting Probe transcript capture"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash -c 'ROOT=\"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-}}\"; [ -n \"${PLUGIN_ROOT:-}\" ] && export PROBE_TAP_SOURCE=codex; exec \"$ROOT/hooks/session-end.sh\"'",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
